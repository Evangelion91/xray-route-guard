#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
    [ -s /etc/xray-route-guard/config.json ] || return 1
    umask 077
    procd_open_instance
    procd_set_param command /usr/sbin/xray-route-guard -config /etc/xray-route-guard/config.json run
    procd_set_param respawn 3600 10 3
    procd_set_param term_timeout 45
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
